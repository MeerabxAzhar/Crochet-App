<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg"
    android:gravity="center"
    android:padding="16dp">

    <!-- Welcome Text with the same color as the buttons -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to the Crochet App!"
        android:textSize="18sp"
        android:textColor="#6b785a"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Centering the Buttons on the page -->

    <!-- Footer with email, SMS, and Cart icons -->


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="299dp"
        android:layout_marginBottom="-50dp"
        android:gravity="center"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnYarn"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#6b785a"
            android:padding="10dp"
            android:text="Yarn"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSweaters"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#6b785a"
            android:padding="10dp"
            android:text="Sweaters"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnMufflers"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#6b785a"
            android:padding="10dp"
            android:text="Mufflers"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnSocks"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#6b785a"
            android:padding="10dp"
            android:text="Socks"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginBottom="-150dp"
        android:layout_marginTop="100dp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="160dp"
        android:gravity="center"
        android:layout_marginBottom="-130dp"
        android:orientation="horizontal">

        <!-- Email Icon -->
        <ImageView
            android:id="@+id/emailIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="30dp"
            android:contentDescription="Send Email"
            android:padding="10dp"
            android:src="@drawable/email" />

        <!-- SMS Icon -->
        <ImageView
            android:id="@+id/phoneIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="30dp"
            android:contentDescription="Phone Icon"
            android:padding="10dp"
            android:src="@drawable/msg" />

        <!-- Music Icon -->
        <ImageView
            android:id="@+id/musicIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="30dp"
            android:contentDescription="Music Icon"
            android:padding="10dp"
            android:src="@drawable/icn_music" />
        <!-- Cart Icon -->
        <ImageView
            android:id="@+id/cartIcon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Cart"
            android:padding="10dp"
            android:src="@drawable/cart" />


    </LinearLayout>
</LinearLayout>
